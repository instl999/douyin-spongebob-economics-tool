# Copy to .env and fill in. Real environment variables override this file.

# --- Ark Agent Plan: the director (script -> storyboard) and image generation
# Key from https://console.volcengine.com/ark  -> API key management. Starts "ark-".
ARK_API_KEY=

# Agent Plan routes through /api/plan/v3. A pay-as-you-go key uses /api/v3
# instead; an Agent Plan key is rejected there with 401.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Verified on the plan. doubao-seedream-4-0-* is NOT on the plan
# (404 UnsupportedModel). The plan also requires >= 2K output (3,686,400 px).
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite
ARK_TEXT_MODEL=doubao-seed-2.0-lite

# --- Speech: narration.  Same Agent Plan key, sent as X-Api-Key.
# The older openspeech scheme (App Key + Access Key from the speech console)
# fails here with 45000010 "grant not found" - it is the wrong header, not a
# missing entitlement. Leave VOLC_TTS_KEY blank to reuse ARK_API_KEY.
VOLC_TTS_KEY=

# doubao-seed-tts-2.0 -> seed-tts-2.0   (ASR would be volc.seedasr.sauc.duration)
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional

# seed-tts-2.0 speaks through the _uranus_ voice family. A _moon_ voice from the
# earlier bigtts models is rejected: "resource ID is mismatched with speaker".
# Verified working: zh_male_yuanboxiaoshu_uranus_bigtts (warm male narrator),
# zh_female_gaolengyujie_uranus_bigtts, zh_female_shuangkuaisisi_uranus_bigtts
VOLC_TTS_SPEAKER=zh_male_yuanboxiaoshu_uranus_bigtts

# --- Local tools (only if not on PATH)
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
