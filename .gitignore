# credentials - never commit
.env

# generated output
out/

# download and generation cache: 239 MB of retrieved clips and generated
# subjects on a single project, all of it re-fetchable from the URLs and
# prompts that are recorded, and some single files past GitHub's 100 MB limit
cache/
**/_build/
**/frames/
**/_narration_parts/
*.partial.*

# pre-matte source images: large, and regenerable from the sprites' prompts
casts/*/raw/

# python
*.pyc
__pycache__/
.venv/

# scratch from re-matting experiments
scripts/_rematte/

# the opening cue: either the user's own file or one gen_sfx builds on first
# use. Not committed - a downloaded 综艺音效 was, once, and this is a public
# MIT repo redistributing whatever sits at this path.
assets/sfx/opening_dong.wav
