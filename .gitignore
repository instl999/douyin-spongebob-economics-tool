# credentials - never commit
.env

# The music library is yours, not the repository's. The folder's README is
# tracked so the naming convention travels with the code; the audio in it is
# licensed to whoever collected it and must not be published here.
assets/bgm/*
!assets/bgm/README.md

# generated output
out/

# download and generation cache: 239 MB of retrieved clips and generated
# subjects on a single project, all of it re-fetchable from the URLs and
# prompts that are recorded, and some single files past GitHub's 100 MB limit
cache/
**/_build/
**/frames/
**/_narration_parts/
*.partial.*

# pre-matte source images: large, and regenerable from the sprites' prompts
casts/*/raw/

# python
*.pyc
__pycache__/
.venv/

# scratch from re-matting experiments
scripts/_rematte/
